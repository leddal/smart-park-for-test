FROM mcr.microsoft.com/dotnet/sdk:10.0 AS dotnet-source
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
WORKDIR /workspace
COPY global.json SmartPark.sln ./
COPY backend/ backend/
COPY samples/ samples/

FROM dotnet-source AS backend-tests
RUN dotnet restore backend/SmartPark.Tests/SmartPark.Tests.csproj --locked-mode
RUN dotnet build backend/SmartPark.Tests/SmartPark.Tests.csproj --no-restore -c Release
ENTRYPOINT ["dotnet", "test", "backend/SmartPark.Tests/SmartPark.Tests.csproj", "--no-build", "--no-restore", "-c", "Release", "--logger", "trx;LogFileName=backend.trx", "--results-directory", "/artifacts/backend"]

FROM dotnet-source AS benchmarks
RUN dotnet restore backend/SmartPark.Benchmarks/SmartPark.Benchmarks.csproj --locked-mode
RUN dotnet build backend/SmartPark.Benchmarks/SmartPark.Benchmarks.csproj --no-restore -c Release
ENTRYPOINT ["dotnet", "run", "--project", "backend/SmartPark.Benchmarks/SmartPark.Benchmarks.csproj", "--no-build", "--no-restore", "-c", "Release"]

FROM node:22-bookworm-slim AS frontend-tests
WORKDIR /workspace/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
CMD ["sh", "-c", "npm run typecheck && npm run lint && npm run test:unit && npm run build"]

FROM mcr.microsoft.com/playwright:v1.56.1-noble AS e2e
WORKDIR /workspace/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV PLAYWRIGHT_BASE_URL=http://web:8080
CMD ["npm", "run", "test:e2e"]
